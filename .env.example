# These are PLATFORM secrets — ArborDocs' own bootstrap credentials: one
# GitHub App and one Discord bot, registered once by the operator. They exist
# before any user/project data does, which is why they're env config and not
# DB rows (same category as DATABASE_URL itself).
#
# Everything about a specific admin or project — who is an admin, which repo,
# which Discord channels — lives in Postgres, never in .env. See
# docs/decisions/0005-multi-tenant-projects.md and
# docs/decisions/0006-admin-authorization-in-db.md.

# GitHub App — used for BOTH admin login (OAuth identity) AND per-project repo
# access (installation flow). One registration, one set of credentials.
GITHUB_APP_ID=
GITHUB_APP_SLUG=                  # the app's URL slug, e.g. "arbordocs" -> github.com/apps/arbordocs
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_B64=        # base64 of the .pem file's contents, e.g.: base64 -i private-key.pem
GITHUB_WEBHOOK_SECRET=

# Discord (single shared bot app; invited per-admin into their own servers;
# guild/channel selection is stored per-project in the DB, not here)
DISCORD_BOT_TOKEN=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# LLM (Stage 2 — see eval/compare_providers.py)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=qwen2.5:7b

# Database (Neon in prod / pgvector-enabled; local dev via docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://arbordocs:arbordocs@localhost:5432/arbordocs

# App
ENV=development
LOG_LEVEL=info
SESSION_SECRET=
BASE_URL=http://localhost:8000    # used to build OAuth callback URLs

# Phase 2 — discussion reconstruction (Stage 0) + candidate filter (Stage 1)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RECONSTRUCTION_INACTIVITY_MINUTES=30
RECONSTRUCTION_SIMILARITY_THRESHOLD=0.45
CANDIDATE_EMBEDDING_THRESHOLD=0.5
WORKER_POLL_INTERVAL_SECONDS=60

# Phase 4, Stage 3 — supersession/reversal tracking
SUPERSESSION_SIMILARITY_THRESHOLD=0.5

# Phase 5 — GitHub content ingestion (docs + code index)
GITHUB_SYNC_INTERVAL_SECONDS=3600
GITHUB_SYNC_MAX_FILE_SIZE_BYTES=200000
GITHUB_SYNC_MAX_FILES=500
